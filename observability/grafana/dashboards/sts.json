{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "panels": [
    {
      "type": "stat", "title": "Token requests / second", "id": 1,
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "reqps", "decimals": 1 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(rate(http_server_request_duration_seconds_count{http_route=\"/token\"}[$__rate_interval]))", "legendFormat": "requests", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Token request p95", "id": 2,
      "gridPos": { "h": 5, "w": 6, "x": 6, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 3 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/token\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Active token requests", "id": 3,
      "gridPos": { "h": 5, "w": 6, "x": 12, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "area", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [{ "expr": "sum(http_server_active_requests{http_route=\"/token\"}) or vector(0)", "legendFormat": "active", "refId": "A" }]
    },
    {
      "type": "stat", "title": "Database connections", "id": 4,
      "gridPos": { "h": 5, "w": 6, "x": 18, "y": 0 },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 0 }, "overrides": [] },
      "options": { "colorMode": "value", "graphMode": "none", "justifyMode": "auto", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false } },
      "targets": [
        { "expr": "db_client_connection_count", "legendFormat": "{{db_client_connection_state}}", "refId": "A" },
        { "expr": "db_client_connection_max", "legendFormat": "max", "refId": "B" }
      ]
    },
    {
      "type": "timeseries", "title": "Token request latency", "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/token\"}[$__rate_interval])))", "legendFormat": "p50", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/token\"}[$__rate_interval])))", "legendFormat": "p95", "refId": "B" },
        { "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_request_duration_seconds_bucket{http_route=\"/token\"}[$__rate_interval])))", "legendFormat": "p99", "refId": "C" }
      ]
    },
    {
      "type": "timeseries", "title": "HTTP traffic by route", "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (http_method, http_route) (rate(http_server_request_duration_seconds_count[$__rate_interval]))", "legendFormat": "{{http_method}} {{http_route}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Database query p95", "id": 7,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, db_query_summary) (rate(db_client_operation_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{db_query_summary}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Database query rate", "id": 8,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 13 },
      "fieldConfig": { "defaults": { "unit": "ops", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (db_query_summary, outcome) (rate(sts_database_queries_total[$__rate_interval]))", "legendFormat": "{{db_query_summary}} {{outcome}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Token processing step p95", "id": 9,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le, step) (rate(sts_token_step_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{step}}", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Connection acquisition wait p95", "id": 10,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 22 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 12, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "histogram_quantile(0.95, sum by (le) (rate(db_client_connection_wait_time_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p95 wait", "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Token processing step average", "id": 12,
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 8, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [{ "expr": "sum by (step) (rate(sts_token_step_duration_seconds_sum{outcome=\"success\"}[$__rate_interval])) / sum by (step) (rate(sts_token_step_duration_seconds_count{outcome=\"success\"}[$__rate_interval]))", "legendFormat": "{{step}}", "refId": "A" }]
    },
    {
      "type": "bargauge", "title": "Slowest token processing steps (average)", "id": 11,
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 31 },
      "fieldConfig": { "defaults": { "unit": "s", "decimals": 4, "min": 0 }, "overrides": [] },
      "options": { "displayMode": "gradient", "orientation": "horizontal", "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }, "showUnfilled": true },
      "targets": [{ "expr": "topk(10, sum by (step) (rate(sts_token_step_duration_seconds_sum{outcome=\"success\"}[$__rate_interval])) / sum by (step) (rate(sts_token_step_duration_seconds_count{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "{{step}}", "instant": true, "refId": "A" }]
    },
    {
      "type": "timeseries", "title": "Token response time by grant type", "id": 13,
      "description": "Time spent authorizing the grant and creating the token response, grouped by grant type.",
      "gridPos": { "h": 9, "w": 24, "x": 0, "y": 40 },
      "fieldConfig": { "defaults": { "unit": "s", "custom": { "drawStyle": "line", "lineInterpolation": "smooth", "lineWidth": 2, "fillOpacity": 10, "showPoints": "never" } }, "overrides": [] },
      "options": { "legend": { "displayMode": "table", "placement": "right", "calcs": ["lastNotNull", "max"] }, "tooltip": { "mode": "multi", "sort": "desc" } },
      "targets": [
        { "expr": "sum by (grant_type) (rate(sts_token_grant_duration_seconds_sum{outcome=\"success\"}[$__rate_interval])) / sum by (grant_type) (rate(sts_token_grant_duration_seconds_count{outcome=\"success\"}[$__rate_interval]))", "legendFormat": "average {{grant_type}}", "refId": "A" },
        { "expr": "histogram_quantile(0.95, sum by (le, grant_type) (rate(sts_token_grant_duration_seconds_bucket{outcome=\"success\"}[$__rate_interval])))", "legendFormat": "p95 {{grant_type}}", "refId": "B" }
      ]
    }
  ],
  "refresh": "5s",
  "schemaVersion": 41,
  "tags": ["sts", "local"],
  "templating": { "list": [] },
  "time": { "from": "now-15m", "to": "now" },
  "timezone": "browser",
  "title": "STS local performance",
  "uid": "sts-local-performance",
  "version": 1
}
