{
  "interactiveLogin": false,
  "tokenCallbacks": [
    {
      "issuerId": "env1",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "system:serviceaccount:${ns}:${workload}",
            "aud": [
              "nais"
            ],
            "kubernetes.io": {
              "namespace": "${ns}",
              "serviceaccount": {
                "name": "${workload}",
                "uid": "899c0fe1-9312-4433-aa53-10a9da1b56db"
              }
            }
          }
        }
      ]
    },
    {
      "issuerId": "env2",
      "tokenExpiry": 3600,
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "client_credentials",
          "claims": {
            "sub": "system:serviceaccount:${ns}:${workload}",
            "aud": [
              "nais"
            ],
            "kubernetes.io": {
              "namespace": "${ns}",
              "serviceaccount": {
                "name": "${workload}",
                "uid": "899c0fe1-9312-4433-aa53-10a9da1b56db"
              }
            }
          }
        }
      ]
    },
    {
      "issuerId": "subject2",
      "requestMappings": [
        {
          "requestParam": "grant_type",
          "match": "authorization_code",
          "claims": {
            "sub": "external-subject",
            "act": {
              "sub": "external-actor",
              "custom": "original-identity",
              "act": {
                "iss": "https://prior.example.com",
                "sub": "earlier-actor"
              }
            }
          }
        }
      ]
    }
  ]
}
