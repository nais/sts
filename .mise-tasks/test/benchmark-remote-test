#!/usr/bin/env bash
#MISE description="Lifecycle test for the remote benchmark task with mocked kubectl, curl and go"
set -euo pipefail

repo_root=$(cd "$(dirname "${BASH_SOURCE[0]}")/../.." && pwd)
cd "$repo_root"
tmp=$(mktemp -d)
trap 'rm -rf "$tmp"' EXIT
mock_bin="$tmp/bin"
mkdir -p "$mock_bin"

cat > "$mock_bin/kubectl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
printf '%s\n' "$*" >> "$MOCK_KUBECTL_LOG"
case "$1" in
  get)
    if [[ "$2" == job ]]; then
      if [[ "${MOCK_JOB_STATE:-Complete}" == Failed ]]; then
        printf '%s\n' '{"status":{"conditions":[{"type":"Failed","status":"True"}]}}'
      else
        printf '%s\n' '{"status":{"conditions":[{"type":"Complete","status":"True"}]}}'
      fi
      exit
    fi
    if [[ "$2" == deployment ]]; then
      printf '%s\n' '{"spec":{"replicas":2,"selector":{"matchLabels":{"app":"sts"}}}}'
      exit
    fi
    if [[ "${*: -1}" == wide ]]; then
      printf '%s\n' '{"items":[]}'
      exit
    fi
    count_file="$MOCK_STATE/pod-snapshots"
    count=0
    [[ ! -f "$count_file" ]] || read -r count < "$count_file"
    count=$((count + 1))
    printf '%s\n' "$count" > "$count_file"
    if [[ "${MOCK_NO_READY:-}" == 1 ]]; then
      printf '%s\n' '{"items":[]}'
      exit
    fi
    restart=0
    [[ "${MOCK_RESTART:-}" != 1 || "$count" -lt 3 ]] || restart=1
    printf '{"items":['
    for pod in sts-0 sts-1; do
      [[ "$pod" == sts-0 ]] || printf ','
      printf '{"metadata":{"name":"%s","uid":"%s-uid"},"status":{"conditions":[{"type":"Ready","status":"True"}],"containerStatuses":[{"name":"sts","restartCount":%s,"containerID":"container-%s"}]}}' \
        "$pod" "$pod" "$restart" "$pod"
    done
    printf ']}\n'
    ;;
  port-forward)
    mapping="${@: -1}"
    port=${mapping%%:*}
    printf 'Forwarding from 127.0.0.1:%s -> 8081\n' "$port"
    trap 'printf x >> "$MOCK_CLEANUP_LOG"; exit 0' TERM INT
    while :; do IFS= read -r -t 1 _ || true; done
    ;;
  create)
    if [[ "$2" == token ]]; then
      printf 'fake-client-assertion\n'
    else
      job_json=$(cat)
      job_name=$(jq -r '.metadata.name' <<< "$job_json")
      printf '%s\n' "$job_json" > "$MOCK_STATE/job-$job_name.json"
      printf '%s\n' "$job_name" >> "$MOCK_STATE/jobs"
    fi
    ;;
  logs)
    job_name=${2#job/}
    selector=$(jq -r '.spec.template.spec.containers[0].command[4]' "$MOCK_STATE/job-$job_name.json")
    grant=${selector#^BenchmarkSts/}
    grant=${grant%\$}
    printf 'BenchmarkSts/%s-1 1 1 ns/op\n' "$grant"
    ;;
  delete)
    printf '%s\n' "$3" >> "$MOCK_STATE/deleted-jobs"
    [[ "${MOCK_DELETE_FAIL:-}" != 1 ]]
    ;;
  describe)
    ;;
  *)
    printf 'unexpected kubectl call: %s\n' "$*" >&2
    exit 2
    ;;
esac
MOCK

cat > "$mock_bin/curl" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
output=
url=
while (($#)); do
  case "$1" in
    -o) output=$2; shift 2 ;;
    http://*|https://*) url=$1; shift ;;
    *) shift ;;
  esac
done
case "$url" in
  */readyz) exit 0 ;;
  */metrics)
    if [[ "${MOCK_METRICS_FAIL:-}" == 1 ]]; then exit 22; fi
    printf 'scraped %s\n' "$url" > "$output"
    ;;
  *) printf 'unexpected curl URL: %s\n' "$url" >&2; exit 2 ;;
esac
MOCK

cat > "$mock_bin/go" <<'MOCK'
#!/usr/bin/env bash
set -euo pipefail
if [[ "$1" == test ]]; then
  printf '%s\n' "$*" >> "$MOCK_GO_CALLS"
  printf 'url=%s assertion=%s subject=%s\n' "$STS_BENCHMARK_URL" \
    "$STS_BENCHMARK_CLIENT_ASSERTION" "$STS_BENCHMARK_SUBJECT_TOKEN" >> "$MOCK_GO_LOG"
  printf 'BenchmarkSts/client_credentials-1 1 1 ns/op\n'
  [[ "${MOCK_BENCHMARK_FAIL:-}" != 1 ]]
elif [[ "$1" == run ]]; then
  printf '%s\n' "$*" >> "$MOCK_GO_CALLS"
  printf '%s\n' "$@" > "$MOCK_REPORT_ARGS"
else
  printf 'unexpected go call: %s\n' "$*" >&2
  exit 2
fi
MOCK
chmod +x "$mock_bin"/*

task="$repo_root/.mise-tasks/test/benchmark-remote"
run_case() {
  local name=$1
  shift
  mkdir -p "$tmp/$name/state" "$tmp/$name/report"
  MOCK_STATE="$tmp/$name/state" \
    MOCK_CLEANUP_LOG="$tmp/$name/cleanup" \
    MOCK_GO_LOG="$tmp/$name/go-log" \
    MOCK_GO_CALLS="$tmp/$name/go-calls" \
    MOCK_KUBECTL_LOG="$tmp/$name/kubectl-calls" \
    MOCK_REPORT_ARGS="$tmp/$name/report-args" \
    PATH="$mock_bin:$PATH" \
    STS_BENCHMARK_REPORT_DIR="$tmp/$name/report" \
    usage_sts_url='https://example.invalid/prefix?keep=1' \
    usage_namespace=test usage_deployment=sts \
    usage_client_namespace=clients usage_service_account=benchmark \
    usage_target='env:clients:target' usage_benchtime=1x usage_metrics_port=18081 \
    env "$@" /bin/bash "$task"
}

assert_contains() {
  local file=$1 text=$2
  if ! grep -Fq -- "$text" "$file"; then
    printf 'expected %s to contain %s\n' "$file" "$text" >&2
    return 1
  fi
}

assert_cluster_jobs() {
  local name=$1 failed=${2:-} expected_jobs=2 job json selector grant
  [[ -z "$failed" ]] || expected_jobs=1
  [[ -s "$tmp/$name/state/jobs" ]]
  [[ $(wc -l < "$tmp/$name/state/jobs") -eq "$expected_jobs" ]]
  while IFS= read -r job; do
    json="$tmp/$name/state/job-$job.json"
    [[ -s "$json" ]]
    jq -e --arg image benchmark-image --arg service_account benchmark \
      --arg url 'https://example.invalid/prefix?keep=1' --arg target 'env:clients:target' \
      '.spec.template.spec.serviceAccountName == $service_account
       and .spec.template.spec.containers[0].image == $image
       and .spec.template.spec.automountServiceAccountToken == false
       and .spec.template.spec.securityContext.runAsNonRoot == true
       and .spec.template.spec.securityContext.runAsUser == 65532
       and .spec.template.spec.containers[0].securityContext.allowPrivilegeEscalation == false
       and .spec.template.spec.containers[0].securityContext.readOnlyRootFilesystem == true
       and .spec.template.spec.volumes[0].projected.sources[0].serviceAccountToken.audience == "nais"
       and ([.spec.template.spec.containers[0].env[] | {key:.name,value:.value}] | from_entries) == {STS_BENCHMARK_URL:$url,STS_BENCHMARK_TARGET:$target,STS_BENCHMARK_TOKEN_FILE:"/var/run/assertion/token"}
       and .spec.template.spec.containers[0].command[0] == "/usr/local/bin/sts-benchmark"
       and .spec.template.spec.containers[0].command[1:4] == ["-test.run","^$","-test.bench"]
       and .spec.template.spec.containers[0].command[5:8] == ["-test.benchtime","1x","-test.benchmem"]
       and .spec.activeDeadlineSeconds == 60
       and .spec.ttlSecondsAfterFinished == 600
       and all(.spec.template.spec.containers[0].env[]; .name != "STS_BENCHMARK_CLIENT_ASSERTION" and .name != "STS_BENCHMARK_SUBJECT_TOKEN")' \
      "$json" >/dev/null
    selector=$(jq -r '.spec.template.spec.containers[0].command[4]' "$json")
    case "$selector" in
      '^BenchmarkSts/client_credentials$') grant=client_credentials ;;
      '^BenchmarkSts/token_exchange$') grant=token_exchange ;;
      *) printf 'unexpected benchmark selector: %s\n' "$selector" >&2; return 1 ;;
    esac
    if [[ -z "$failed" ]]; then
      assert_contains "$tmp/$name/report/benchmark.txt" "BenchmarkSts/$grant-1"
    fi
  done < "$tmp/$name/state/jobs"
  if [[ -z "$failed" ]]; then
    assert_contains "$tmp/$name/report-args" '-request-path'
    assert_contains "$tmp/$name/report-args" 'cluster'
    for grant in client_credentials token_exchange; do
      for pod in sts-0 sts-1; do
        for phase in before after; do
          assert_contains "$tmp/$name/report-args" "$grant=$tmp/$name/report/$grant-$pod-$phase.prom"
        done
      done
    done
  fi
  [[ $(wc -l < "$tmp/$name/state/deleted-jobs") -eq "$expected_jobs" ]]
  diff -u <(sort "$tmp/$name/state/jobs") <(sort "$tmp/$name/state/deleted-jobs")
  if [[ -f "$tmp/$name/go-calls" ]] && grep -Fq 'test -run' "$tmp/$name/go-calls"; then
    printf 'cluster branch ran a local go test\n' >&2
    return 1
  fi
  if grep -Fq 'create token' "$tmp/$name/kubectl-calls"; then
    printf 'cluster branch requested a raw create token\n' >&2
    return 1
  fi
}

run_case success
assert_contains "$tmp/success/go-log" 'url=https://example.invalid/prefix?keep=1 assertion=fake-client-assertion subject=fake-client-assertion'
[[ $(wc -l < "$tmp/success/go-log") -eq 2 ]]
for grant in client_credentials token_exchange; do
  for pod in sts-0 sts-1; do
    for phase in before after; do
      path="$tmp/success/report/$grant-$pod-$phase.prom"
      [[ -s "$path" ]]
      assert_contains "$tmp/success/report-args" "$grant=$path"
    done
  done
done
[[ $(wc -c < "$tmp/success/cleanup") -eq 2 ]]

mkdir -p "$tmp/no-ready"
if run_case no-ready MOCK_NO_READY=1 > "$tmp/no-ready/output" 2>&1; then
  printf 'no-ready case unexpectedly succeeded\n' >&2
  exit 1
fi
assert_contains "$tmp/no-ready/output" 'Wait for all STS replicas to be ready'
if grep -Fq 'unbound variable' "$tmp/no-ready/output"; then
  printf 'no-ready case used an unbound variable\n' >&2
  exit 1
fi
[[ ! -e "$tmp/no-ready/cleanup" ]]

run_case metrics-fail MOCK_METRICS_FAIL=1
assert_contains "$tmp/metrics-fail/report-args" '-metrics-incomplete'
assert_contains "$tmp/metrics-fail/report-args" 'A server metrics snapshot failed.'
[[ $(wc -c < "$tmp/metrics-fail/cleanup") -eq 2 ]]

run_case restart MOCK_RESTART=1
assert_contains "$tmp/restart/report-args" '-metrics-incomplete'
assert_contains "$tmp/restart/report-args" 'STS pods or restart counts changed during the run.'
[[ $(wc -c < "$tmp/restart/cleanup") -eq 2 ]]

mkdir -p "$tmp/benchmark-fail"
if run_case benchmark-fail MOCK_BENCHMARK_FAIL=1 > "$tmp/benchmark-fail/output" 2>&1; then
  printf 'benchmark-fail case unexpectedly succeeded\n' >&2
  exit 1
fi
[[ $(wc -c < "$tmp/benchmark-fail/cleanup") -eq 2 ]]

run_case cluster STS_BENCHMARK_JOB_IMAGE=benchmark-image STS_BENCHMARK_JOB_TIMEOUT_SECONDS=60
assert_cluster_jobs cluster

mkdir -p "$tmp/cluster-fail"
cluster_fail_status=0
run_case cluster-fail STS_BENCHMARK_JOB_IMAGE=benchmark-image STS_BENCHMARK_JOB_TIMEOUT_SECONDS=60 \
  MOCK_JOB_STATE=Failed MOCK_DELETE_FAIL=1 > "$tmp/cluster-fail/output" 2>&1 || cluster_fail_status=$?
if [[ "$cluster_fail_status" -ne 1 ]]; then
  printf 'cluster-fail case exit status = %s, want 1\n' "$cluster_fail_status" >&2
  exit 1
fi
assert_contains "$tmp/cluster-fail/output" 'did not complete (Failed)'
assert_contains "$tmp/cluster-fail/output" 'Failed to delete benchmark Job'
assert_contains "$tmp/cluster-fail/output" 'kubectl delete job'
assert_cluster_jobs cluster-fail failed

printf 'benchmark-remote lifecycle tests passed\n'
