#!/usr/bin/env bash
#MISE description="Package a chart for CI"

set -euo pipefail

chart="${1:?Supply the chart directory}"

# Use the latest release so delayed runs do not restore older images.
IMAGE_TAG=$(gh release view --json tagName --jq .tagName)
version="$(date -u +%Y-%m-%d-%H%M%S)-$(git rev-parse --short=7 HEAD)"
export IMAGE_TAG CHART_VERSION="$version"

yq -i '.image.tag = strenv(IMAGE_TAG)' "$chart/values.yaml"
yq -i '.version = strenv(CHART_VERSION) | .appVersion = strenv(IMAGE_TAG)' "$chart/Chart.yaml"

# Local subcharts are bundled with this release, not published independently.
# Keep their versions and the parent's pins aligned with the generated version.
local_dependencies_updated=false
while IFS= read -r repository; do
  dependency="$chart/${repository#file://}"
  yq -i '.version = strenv(CHART_VERSION)' "$dependency/Chart.yaml"
  LOCAL_REPOSITORY="$repository" yq -i '
    (.dependencies[] | select(.repository == strenv(LOCAL_REPOSITORY))).version = strenv(CHART_VERSION)
  ' "$chart/Chart.yaml"
  local_dependencies_updated=true
done < <(yq -r '.dependencies[]? | select(.repository | test("^file://")) | .repository' "$chart/Chart.yaml")

if "$local_dependencies_updated"; then
  # Version changes invalidate the checked-in dependency lock.
  helm dependency update "$chart" --skip-refresh
else
  helm dependency build "$chart"
fi

# Timestamp versions package successfully but fail strict SemVer lint.
helm lint "$chart"
helm package "$chart"

echo "version=$version" >> "$GITHUB_OUTPUT"
