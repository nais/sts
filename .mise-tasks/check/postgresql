#!/usr/bin/env bash
#MISE description="Test postgresql chart rendering and value validation"
#MISE depends=["check:helm-lint"]
set -euo pipefail

chart=./charts/postgresql

render() {
  helm template test "$chart" --namespace application "$@" | yq -o=json | jq -s .
}

render | jq -e '
  length == 1 and
  .[0].apiVersion == "postgresql.cnpg.io/v1" and
  .[0].kind == "Cluster" and
  .[0].metadata.name == "test-postgresql" and
  .[0].metadata.namespace == "application" and
  .[0].metadata.annotations["helm.sh/resource-policy"] == "keep" and
  .[0].spec.instances == 3 and
  .[0].spec.imageName == "ghcr.io/cloudnative-pg/postgresql:18" and
  .[0].spec.bootstrap.initdb == {"database":"app", "owner":"app"} and
  .[0].spec.enableSuperuserAccess == false and
  .[0].spec.storage.size == "10Gi" and
  (.[0].spec.storage | has("storageClass") | not) and
  (.[0].spec.bootstrap.initdb | has("secret") | not) and
  .[0].spec.affinity.podAntiAffinityType == "required"
' >/dev/null

render --set fullnameOverride=custom-db --set instances=1 --set keep=false \
  --set database.name=app --set database.owner=app_owner \
  --set storage.size=20Gi --set storage.storageClass=fast \
  --set imageName=example.invalid/postgres:18.1 \
  --set affinity.podAntiAffinityType=preferred \
  --set-string postgresql.parameters.max_connections=200 \
  --set-string annotations.example=custom | jq -e '
    .[0].metadata.name == "custom-db" and
    .[0].metadata.annotations == {"example":"custom"} and
    .[0].spec.instances == 1 and
    .[0].spec.bootstrap.initdb == {"database":"app", "owner":"app_owner"} and
    .[0].spec.storage == {"size":"20Gi", "storageClass":"fast"} and
    .[0].spec.imageName == "example.invalid/postgres:18.1" and
    .[0].spec.affinity.podAntiAffinityType == "preferred" and
    .[0].spec.postgresql.parameters.max_connections == "200"
  ' >/dev/null

render --set keep=false | jq -e '
  .[0].metadata | has("annotations") | not
' >/dev/null

render --set nameOverride=database | jq -e '
  .[0].metadata.name == "test-database"
' >/dev/null

render --set networkPolicy.enabled=true --set fullnameOverride=custom-db \
  --set-json 'networkPolicy.ingress=[{"from":[{"podSelector":{"matchLabels":{"app":"example"}}}],"ports":[{"protocol":"TCP","port":5432}]}]' \
  --set-json 'networkPolicy.egress=[{"to":[{"ipBlock":{"cidr":"192.0.2.1/32"}}],"ports":[{"protocol":"TCP","port":443}]}]' \
  | jq -e '
    length == 3 and
    ([.[] | select(.kind == "NetworkPolicy" and .metadata.name == "custom-db")] | .[0] |
      .metadata.name == "custom-db" and
      .metadata.namespace == "application" and
      .spec.podSelector.matchLabels == {"cnpg.io/cluster":"custom-db"} and
      .spec.policyTypes == ["Ingress", "Egress"] and
      .spec.ingress[0].from[0].podSelector.matchLabels == {"cnpg.io/cluster":"custom-db"} and
      .spec.egress[0].to[0].podSelector.matchLabels == {"cnpg.io/cluster":"custom-db"} and
      .spec.ingress[1].from[0].podSelector.matchLabels == {"app.kubernetes.io/instance":"test"} and
      .spec.ingress[1].ports[0].port == 5432 and
      .spec.ingress[2].from[0].namespaceSelector.matchLabels["kubernetes.io/metadata.name"] == "nais-system" and
      .spec.ingress[2].from[0].podSelector.matchLabels["app.kubernetes.io/name"] == "cloudnative-pg" and
      .spec.ingress[2].ports[0].port == 8000 and
      .spec.ingress[-1].from[0].podSelector.matchLabels.app == "example" and
      .spec.ingress[-1].ports[0].port == 5432 and
      .spec.egress[-1].to[0].ipBlock.cidr == "192.0.2.1/32" and
      .spec.egress[-1].ports[0].port == 443
    ) and
    ([.[] | select(.kind == "NetworkPolicy" and .metadata.name == "test-postgres")] | .[0].spec |
      .podSelector.matchLabels == {"app.kubernetes.io/instance":"test"} and
      .policyTypes == ["Egress"] and
      .egress == [{
        "to":[{"podSelector":{"matchLabels":{"cnpg.io/cluster":"custom-db"}}}],
        "ports":[{"port":5432,"protocol":"TCP"}]
      }]
    )
  ' >/dev/null

render --set networkPolicy.enabled=true \
  --set networkPolicy.operator.name=custom-operator \
  --set networkPolicy.operator.namespace=operators \
  | jq -e '
    ([.[] | select(.kind == "NetworkPolicy" and .metadata.name == "test-postgresql")] | .[0].spec |
      (.ingress | length) == 3 and
      .ingress[1].from[0].podSelector.matchLabels == {"app.kubernetes.io/instance":"test"} and
      (.ingress[1].from[0] | has("namespaceSelector") | not) and
      .ingress[1].ports[0].port == 5432 and
      .ingress[2].from[0].namespaceSelector.matchLabels["kubernetes.io/metadata.name"] == "operators" and
      .ingress[2].from[0].podSelector.matchLabels["app.kubernetes.io/name"] == "custom-operator" and
      .ingress[2].ports[0].port == 8000 and
      (.egress | length) == 2 and
      .egress[0] == {"to":[{"podSelector":{"matchLabels":{"cnpg.io/cluster":"test-postgresql"}}}]} and
      (.egress[1].to | length) == 2 and
      .egress[1].to[0].namespaceSelector.matchLabels["kubernetes.io/metadata.name"] == "kube-system" and
      .egress[1].to[0].podSelector.matchLabels["k8s-app"] == "kube-dns" and
      .egress[1].to[1].podSelector.matchLabels["k8s-app"] == "node-local-dns" and
      .egress[1].ports == [{"protocol":"UDP","port":53},{"protocol":"TCP","port":53}]
    )
  ' >/dev/null

render --set networkPolicy.enabled=true \
  --set-json 'networkPolicy.apiServerCidrs=["172.16.1.2/32","192.0.2.2/32"]' \
  --set-json 'networkPolicy.dnsCidrs=["192.168.8.10/32","192.0.2.53/32"]' \
  | jq -e '
    [.[] | select(.kind == "NetworkPolicy" and .metadata.name == "test-postgresql")][0].spec.egress |
    length == 3 and
    .[1].to == [{"ipBlock":{"cidr":"172.16.1.2/32"}},{"ipBlock":{"cidr":"192.0.2.2/32"}}] and
    .[1].ports == [{"protocol":"TCP","port":443}] and
    (.[2].to | length) == 4 and
    .[2].to[2:] == [{"ipBlock":{"cidr":"192.168.8.10/32"}},{"ipBlock":{"cidr":"192.0.2.53/32"}}] and
    .[2].ports == [{"protocol":"UDP","port":53},{"protocol":"TCP","port":53}]
  ' >/dev/null

for invalid in instances=0 instances=1.5 storage.size=0Gi database.owner=postgres \
  database.name=template0 postgresql.parameters.max_connections=200 \
  affinity.podAntiAffinityType=invalid replicaCount=2 networkPolicy.ingress=invalid \
  networkPolicy.apiServer.port=443 networkPolicy.appRelease=true \
  networkPolicy.appName=obsolete networkPolicy.dns.enabled=true networkPolicy.operator.name= \
  networkPolicy.apiServerCidrs=invalid networkPolicy.dnsCidrs=invalid; do
  if helm template test "$chart" --set "$invalid" >/dev/null 2>&1; then
    printf 'Expected validation failure for %s\n' "$invalid" >&2
    exit 1
  fi
done

# Exercise real parent/subchart coalescing, aliases, globals, and conditions.
parent=$(mktemp -d)
trap 'rm -rf "$parent"' EXIT
mkdir -p "$parent/charts"
cp -R "$chart" "$parent/charts/postgresql"
printf '%s\n' \
  'apiVersion: v2' \
  'name: example' \
  'version: 0.1.0' \
  'dependencies:' \
  '  - name: postgresql' \
  '    alias: postgresql' \
  '    version: 0.1.0' \
  '    condition: postgresqlEnabled' > "$parent/Chart.yaml"

helm template example "$parent" --namespace application \
  --set postgresqlEnabled=true --set global.platform=example \
  --set postgresql.database.name=custom --set postgresql.database.owner=custom \
  --set postgresql.instances=2 | yq -o=json | jq -s -e '
    length == 1 and
    .[0].metadata.name == "example-postgresql" and
    .[0].metadata.namespace == "application" and
    .[0].spec.instances == 2 and
    .[0].spec.bootstrap.initdb == {"database":"custom", "owner":"custom"}
  ' >/dev/null

helm template example "$parent" --namespace application \
  --set postgresqlEnabled=true --set postgresql.networkPolicy.enabled=true \
  | yq -o=json | jq -s -e '
    length == 3 and
    ([.[] | select(.kind == "NetworkPolicy" and .metadata.name == "example-postgresql")] | .[0] |
      .metadata.name == "example-postgresql" and
      .spec.podSelector.matchLabels["cnpg.io/cluster"] == "example-postgresql" and
      .spec.ingress[1].from[0].podSelector.matchLabels == {"app.kubernetes.io/instance":"example"} and
      .spec.ingress[1].ports[0].port == 5432
    )
  ' >/dev/null

if [[ -n $(helm template example "$parent" --set postgresqlEnabled=false) ]]; then
  printf 'Disabled dependency should not render any resources\n' >&2
  exit 1
fi

# Check the real authserver Deployment's reference against the rendered Cluster.
for cluster_name in sts-postgresql custom-db "$(printf 'a%.0s' {1..50})"; do
  helm template authserver ./charts/sts-authserver --namespace application \
    --set-string "postgresql.fullnameOverride=$cluster_name" | yq -o=json | jq -s -e '
      ([.[] | select(.kind == "Cluster")][0].metadata.name + "-app") as $secret |
      [.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
      map(select(.name == "DATABASE_URL")) == [
        {"name":"DATABASE_URL", "valueFrom":{"secretKeyRef":{"name":$secret,"key":"uri"}}}
      ]
    ' >/dev/null
done

for invalid_name in '' invalid.name "$(printf 'a%.0s' {1..51})"; do
  if helm template authserver ./charts/sts-authserver \
    --set-string "postgresql.fullnameOverride=$invalid_name" >/dev/null 2>&1; then
    printf 'Expected validation failure for Cluster name: %s\n' "$invalid_name" >&2
    exit 1
  fi
done

helm template authserver ./charts/sts-authserver --set postgresqlEnabled=false \
  --set-string postgresql.fullnameOverride= --set config.databaseUrl=postgres://external/app | yq -o=json | jq -s -e '
    all(.[]; .kind != "Cluster") and
    ([.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
      all(.[]; .name != "DATABASE_URL")) and
    ([.[] | select(.kind == "Secret")][0].stringData["config.yaml"] |
      contains("databaseUrl: postgres://external/app"))
  ' >/dev/null

printf 'postgresql render tests passed\n'
