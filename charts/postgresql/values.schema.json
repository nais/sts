{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "postgresql values",
  "type": "object",
  "additionalProperties": false,
  "required": ["instances", "imageName", "database", "storage", "resources", "affinity", "keep"],
  "properties": {
    "global": {"type": "object", "description": "Helm-injected parent globals; accepted but not used by this chart."},
    "nameOverride": {"type": "string", "maxLength": 50, "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"},
    "fullnameOverride": {"type": "string", "maxLength": 50, "pattern": "^$|^[a-z]([a-z0-9-]*[a-z0-9])?$"},
    "keep": {"type": "boolean"},
    "instances": {"type": "integer", "minimum": 1},
    "imageName": {"type": "string", "minLength": 1},
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "owner"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "maxLength": 63, "not": {"enum": ["postgres", "template0", "template1"]}},
        "owner": {"type": "string", "pattern": "^[a-z_][a-z0-9_]*$", "maxLength": 63, "not": {"pattern": "^(postgres$|pg_)"}}
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["size"],
      "properties": {
        "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
        "storageClass": {"type": "string"}
      }
    },
    "resources": {"type": "object"},
    "affinity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enablePodAntiAffinity", "podAntiAffinityType", "topologyKey"],
      "properties": {
        "enablePodAntiAffinity": {"type": "boolean"},
        "podAntiAffinityType": {"enum": ["required", "preferred"]},
        "topologyKey": {"type": "string", "minLength": 1},
        "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
        "tolerations": {"type": "array", "items": {"type": "object"}}
      }
    },
    "postgresql": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "parameters": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "operator", "apiServerCidrs", "dnsCidrs", "ingress", "egress"],
      "properties": {
        "enabled": {"type": "boolean"},
        "apiServerCidrs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "dnsCidrs": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "operator": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "namespace"],
          "properties": {
            "name": {"type": "string", "minLength": 1, "maxLength": 63},
            "namespace": {"type": "string", "minLength": 1, "maxLength": 63}
          }
        },
        "ingress": {"type": "array", "items": {"type": "object"}},
        "egress": {"type": "array", "items": {"type": "object"}}
      }
    },
    "annotations": {
      "type": "object",
      "propertyNames": {"not": {"const": "helm.sh/resource-policy"}},
      "additionalProperties": {"type": "string"}
    }
  }
}
