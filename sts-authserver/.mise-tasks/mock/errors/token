#!/usr/bin/env bash
#MISE description="Send failing requests to the mock authserver token endpoint"
#MISE env={CONFIG_FILE = "config.yaml"}

set -euo pipefail

ISSUER=$(yq -er '.authorizationServer.issuer' "${CONFIG_FILE}")
MOCK="http://localhost:3004"
ASSERTION_TYPE="urn:ietf:params:oauth:client-assertion-type:jwt-bearer"
TOKEN_EXCHANGE="urn:ietf:params:oauth:grant-type:token-exchange"
JWT_TYPE="urn:ietf:params:oauth:token-type:jwt"
ACCESS_TOKEN_TYPE="urn:ietf:params:oauth:token-type:access_token"
TARGET="env1:namespace1:workload2"

workload_token() {
  curl -sS --fail-with-body "${MOCK}/$1/token" \
    -d 'grant_type=client_credentials' \
    -d 'client_secret=yolo' \
    -d 'ns=namespace1' \
    -d "workload=$2" \
    -d 'client_id=default_client' | jq -r '.access_token'
}

request() {
  printf '### %s\n' "$1"
  shift
  curl -sS -w ' [%{http_code}]\n' "${ISSUER}/token" "$@"
}

exchange() {
  local label="$1" assertion="$2" target="$3" subject="$4"
  request "$label" \
    -d "grant_type=${TOKEN_EXCHANGE}" \
    -d "client_assertion_type=${ASSERTION_TYPE}" \
    -d "client_assertion=${assertion}" \
    -d "audience=${target}" \
    -d "subject_token=${subject}" \
    -d "subject_token_type=${JWT_TYPE}" \
    -d "requested_token_type=${ACCESS_TOKEN_TYPE}"
}

CLIENT_ASSERTION=$(workload_token env1 workload1)
UNTRUSTED_ASSERTION=$(workload_token untrusted workload1)
REDIRECT_URI="https://unused.example/callback"
AUTHORIZATION_RESPONSE=$(curl -sS --fail-with-body --get --write-out '%{redirect_url}' \
  "${MOCK}/subject1/authorize" \
  -d 'client_id=default_client' \
  -d 'scope=openid%20somescope' \
  -d 'response_type=code' \
  -d "redirect_uri=${REDIRECT_URI}")
AUTHORIZATION_CODE=$(jq -rR 'capture("[?&]code=(?<code>[^&]+)").code' <<< "${AUTHORIZATION_RESPONSE}")
SUBJECT_TOKEN=$(curl -sS --fail-with-body "${MOCK}/subject1/token" \
  -d 'grant_type=authorization_code' \
  -d "code=${AUTHORIZATION_CODE}" \
  -d 'client_secret=yolo' \
  -d 'client_id=default_client' \
  -d "redirect_uri=${REDIRECT_URI}" | jq -r '.access_token')

request "unsupported grant type" \
  -d 'grant_type=client_credentials'

request "json body" \
  -H 'Content-Type: application/json' \
  -d "{\"grant_type\":\"${TOKEN_EXCHANGE}\"}"

request "body too large" \
  --data-binary "grant_type=$(head -c 70000 /dev/zero | tr '\0' a)"

exchange "missing client assertion" "" "${TARGET}" "${SUBJECT_TOKEN}"
exchange "malformed client assertion" "not-a-jwt" "${TARGET}" "${SUBJECT_TOKEN}"
exchange "untrusted client assertion issuer" "${UNTRUSTED_ASSERTION}" "${TARGET}" "${SUBJECT_TOKEN}"
exchange "tampered client assertion signature" "${CLIENT_ASSERTION%?????}AAAAA" "${TARGET}" "${SUBJECT_TOKEN}"
exchange "unregistered client" "$(workload_token env1 unregistered)" "${TARGET}" "${SUBJECT_TOKEN}"
exchange "unauthorized target" "${CLIENT_ASSERTION}" "env1:namespace1:unauthorized-target" "${SUBJECT_TOKEN}"
exchange "malformed subject token" "${CLIENT_ASSERTION}" "${TARGET}" "not-a-jwt"
exchange "untrusted subject token issuer" "${CLIENT_ASSERTION}" "${TARGET}" "${UNTRUSTED_ASSERTION}"
