#!/usr/bin/env bash
#MISE description="Get a client credentials token from the mock authserver"
#MISE env={CONFIG_FILE = "config.yaml"}
#USAGE flag "-e --environment <environment>" help="The environment to use for the token request" default="env1"
#USAGE flag "-n --namespace <namespace>" help="The namespace to use for the token request" default="namespace1"
#USAGE flag "-w --workload <workload>" help="The workload to use for the token request" default="workload1"
#USAGE flag "-t --target_workload <target_workload>" help="The target workload to use for the token request" default="workload2"

set -euo pipefail

ISSUER=$(yq -er '.authorizationServer.issuer' "${CONFIG_FILE}")

ENV="${usage_environment}"

if ! WORKLOAD_RESPONSE=$(curl -sS --fail-with-body \
  "http://localhost:3004/${ENV}/token" \
  -d 'grant_type=client_credentials' \
  -d 'client_secret=yolo' \
  -d "ns=${usage_namespace}" \
  -d "workload=${usage_workload}" \
  -d 'client_id=default_client'); then
  printf '%s\n' "${WORKLOAD_RESPONSE}" >&2
  exit 1
fi

WORKLOAD_TOKEN=$(jq -r '.access_token' <<< "${WORKLOAD_RESPONSE}")
printf '%s\n' "Authenticating with token:"
printf '%s\n' "${WORKLOAD_TOKEN}" | step crypto jwt inspect --insecure | jq -r .

if ! TOKEN_RESPONSE=$(curl -sS --fail-with-body \
   "${ISSUER}/token" \
  -d 'grant_type=client_credentials' \
  -d 'client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer' \
  -d "client_assertion=${WORKLOAD_TOKEN}" \
  -d "scope=${ENV}:${usage_namespace}:${usage_target_workload}"); then
  printf '%s\n' "${TOKEN_RESPONSE}" >&2
  exit 1
fi

printf '%s\n' "${TOKEN_RESPONSE}" | jq -r '.access_token' | step crypto jwt inspect --insecure | jq -r .
