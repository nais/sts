#!/usr/bin/env bash
#MISE description="Test authserver chart configuration and database wiring"
#MISE depends=["//:check:helm-lint"]
set -euo pipefail

# Check the Deployment's Secret reference against a custom dependency Cluster name.
helm template authserver ../charts/sts-authserver --namespace application \
  --set-string postgresql.fullnameOverride=custom-db | yq -o=json | jq -s -e '
    ([.[] | select(.kind == "Cluster")][0].metadata.name + "-app") as $secret |
    [.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
    map(select(.name == "DATABASE_URL")) == [
      {"name":"DATABASE_URL", "valueFrom":{"secretKeyRef":{"name":$secret,"key":"uri"}}}
    ]
  ' >/dev/null

# An empty Cluster name must fail the chart's required-value validation.
if helm template authserver ../charts/sts-authserver \
  --set-string postgresql.fullnameOverride= >/dev/null 2>&1; then
  printf 'Expected validation failure for empty Cluster name\n' >&2
  exit 1
fi

helm template authserver ../charts/sts-authserver --set postgresqlEnabled=false \
  --set-string postgresql.fullnameOverride= --set config.databaseUrl=postgres://external/app | yq -o=json | jq -s -e '
    all(.[]; .kind != "Cluster") and
    ([.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
      all(.[]; .name != "DATABASE_URL")) and
    ([.[] | select(.kind == "Secret")][0].stringData["config.yaml"] |
      contains("databaseUrl: postgres://external/app"))
  ' >/dev/null

# Parse the embedded application config, not just the Kubernetes manifest.
config_dir=$(mktemp -d)
trap 'rm -rf "$config_dir"' EXIT

render_config() {
  helm template authserver ../charts/sts-authserver \
    --show-only templates/config-secret.yaml "$@" |
    yq -r '.stringData["config.yaml"]' | yq -o=json
}

render_config | tee "$config_dir/default.json" | jq -e '
  .authorizationServer.externalIssuers == {}
' >/dev/null

render_config \
  --set-json 'config.authorizationServer.externalIssuers={"identity":"https://identity.example.com"}' \
  --set-json 'config.authorizationServer.clientAuthIssuers={
    "cluster-dev":{"issuer":"https://issuer.example.com/dev","alias":"kubernetes","mode":"workload","expectedAudience":"true","maxTokenLifetime":"5m","clientClaims":{"namespace":"kubernetes.io.namespace","name":"kubernetes.io.serviceaccount.name"}},
    "cluster-prod":{"issuer":"https://issuer.example.com/prod","alias":"kubernetes","mode":"workload","clientClaims":{"namespace":"kubernetes.io.namespace","name":"kubernetes.io.serviceaccount.name"}},
    "employee":{"issuer":"https://people.example.com","alias":"employee","mode":"impersonation","expectedAudience":"people-app"}
  }' \
  --set-json 'config.authorizationServer.environments=[
    {"name":"dev-gcp","clientAuthIssuers":["cluster-dev","employee"],"registrator":{"issuerRef":"cluster-dev","subject":"system:serviceaccount:custom:operator # literal","registratorJwksUri":"https://operator.dev.example.com/jwks","signingAlg":"ES256"}},
    {"name":"prod-gcp","clientAuthIssuers":["cluster-prod","employee"],"registrator":{"issuerRef":"cluster-prod","subject":"system:serviceaccount:nais-system:sts-operator","registratorJwksUri":"https://operator.prod.example.com/jwks","signingAlg":"RS256"}}
  ]' | tee "$config_dir/custom.json" | jq -e '
    .authorizationServer as $auth |
    $auth.clientAuthIssuers["cluster-dev"].expectedAudience == "true" and
    $auth.externalIssuers == {"identity":"https://identity.example.com"} and
    ($auth.environments | length) == 2 and
    $auth.environments[0].registrator.subject == "system:serviceaccount:custom:operator # literal"
  ' >/dev/null

# Fasit passes the same key as a string, not a YAML map.
fasit_issuers='config.authorizationServer.externalIssuers="{\"one\":\"https://identity.example.com/one\",\"two\":\"https://identity.example.com/two\"}"'
render_config --set-json "$fasit_issuers" | tee "$config_dir/fasit.json" | jq -e '
  .authorizationServer.externalIssuers == {
    "one": "https://identity.example.com/one",
    "two": "https://identity.example.com/two"
  }
' >/dev/null

for invalid in '"{"' '"[]"' '"null"' '"{\"identity\":42}"' '{"identity":42}'; do
  if render_config --set-json "config.authorizationServer.externalIssuers=$invalid" >/dev/null 2>&1; then
    printf 'Expected validation failure for externalIssuers=%s\n' "$invalid" >&2
    exit 1
  fi
done

# Check the rendered configuration with the same defaults and validation as startup.
STS_TEST_CONFIG_DIR="$config_dir" go test -count=1 ./internal/sts -run '^TestLoadRenderedConfigs$'

# FQDN egress: deduplicated registrator JWKS and external issuer hosts;
# only when enabled and the GKE API is available.
fqdn_policy() {
  helm template authserver ../charts/sts-authserver --show-only templates/fqdnnetpol.yaml "$@" | yq -o=json
}
fqdn_policy --api-versions networking.gke.io/v1alpha3 \
  --set-json 'config.authorizationServer.environments=[
    {"name":"a","clientAuthIssuers":["cluster-env1"],"registrator":{"issuerRef":"cluster-env1","subject":"operator-a","registratorJwksUri":"https://op.example.com:8443/jwks","signingAlg":"ES256"}},
    {"name":"b","clientAuthIssuers":["cluster-env1"],"registrator":{"issuerRef":"cluster-env1","subject":"operator-b","registratorJwksUri":"https://op.example.com/jwks","signingAlg":"ES256"}},
    {"name":"c","clientAuthIssuers":["cluster-env1"],"registrator":{"issuerRef":"cluster-env1","subject":"operator-c","registratorJwksUri":"https://other.example.com/jwks","signingAlg":"ES256"}}
  ]' | jq -e '
    .kind == "FQDNNetworkPolicy" and
    .spec.egress == [{
      "to": [{"fqdns": ["op.example.com", "other.example.com"]}],
      "ports": [{"protocol": "TCP", "port": 443}]
    }]
  ' >/dev/null

fqdn_policy --api-versions networking.gke.io/v1alpha3 --set-json "$fasit_issuers" | jq -e '
    .spec.egress == [{
      "to": [{"fqdns": ["sts-operator.environment.tenant.cloud.nais.io", "identity.example.com"]}],
      "ports": [{"protocol": "TCP", "port": 443}]
    }]
  ' >/dev/null

for args in '' '--api-versions networking.gke.io/v1alpha3 --set fqdnNetworkPolicy.enabled=false'; do
  # shellcheck disable=SC2086 # Intentional word splitting of Helm flags.
  helm template authserver ../charts/sts-authserver $args | yq -o=json | jq -s -e '
    all(.[]; .kind != "FQDNNetworkPolicy")
  ' >/dev/null
done

printf 'authserver render tests passed\n'
