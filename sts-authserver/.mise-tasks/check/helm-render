#!/usr/bin/env bash
#MISE description="Test authserver chart configuration and database wiring"
#MISE depends=["//:check:helm-lint"]
set -euo pipefail

# Check the Deployment's Secret reference against a custom dependency Cluster name.
helm template authserver ../charts/sts-authserver --namespace application \
  --set-string postgresql.fullnameOverride=custom-db | yq -o=json | jq -s -e '
    ([.[] | select(.kind == "Cluster")][0].metadata.name + "-app") as $secret |
    [.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
    map(select(.name == "DATABASE_URL")) == [
      {"name":"DATABASE_URL", "valueFrom":{"secretKeyRef":{"name":$secret,"key":"uri"}}}
    ]
  ' >/dev/null

# An empty Cluster name must fail the chart's required-value validation.
if helm template authserver ../charts/sts-authserver \
  --set-string postgresql.fullnameOverride= >/dev/null 2>&1; then
  printf 'Expected validation failure for empty Cluster name\n' >&2
  exit 1
fi

helm template authserver ../charts/sts-authserver --set postgresqlEnabled=false \
  --set-string postgresql.fullnameOverride= --set config.databaseUrl=postgres://external/app | yq -o=json | jq -s -e '
    all(.[]; .kind != "Cluster") and
    ([.[] | select(.kind == "Deployment")][0].spec.template.spec.containers[0].env |
      all(.[]; .name != "DATABASE_URL")) and
    ([.[] | select(.kind == "Secret")][0].stringData["config.yaml"] |
      contains("databaseUrl: postgres://external/app"))
  ' >/dev/null

# Parse the embedded application config, not just the Kubernetes manifest.
config_dir=$(mktemp -d)
trap 'rm -rf "$config_dir"' EXIT

render_config() {
  helm template authserver ../charts/sts-authserver \
    --show-only templates/config-secret.yaml "$@" |
    yq -r '.stringData["config.yaml"]' | yq -o=json
}

render_config > "$config_dir/default.json"

render_config \
  --set 'config.authorizationServer.clientAuthSigningAlgorithms[0]=ES256' \
  --set config.authorizationServer.maxClientAuthTokenLifetime=5m \
  --set-string config.authorizationServer.expectedAudience=true \
  --set-json 'config.authorizationServer.subjectTokenIssuers={"https://identity.example.com":"identity"}' \
  --set-json 'config.authorizationServer.environments=[
    {"name":"dev-gcp","clientAuthIssuer":"https://issuer.example.com/dev","registrator":{"subject":"system:serviceaccount:custom:operator # literal","registratorJwksUri":"https://operator.dev.example.com/jwks","signingAlg":"ES256"}},
    {"name":"prod-gcp","clientAuthIssuer":"https://issuer.example.com/prod","registrator":{"subject":"system:serviceaccount:nais-system:sts-operator","registratorJwksUri":"https://operator.prod.example.com/jwks","signingAlg":"RS256"}}
  ]' | tee "$config_dir/custom.json" | jq -e '
    .authorizationServer as $auth |
    $auth.expectedAudience == "true" and
    ($auth.environments | length) == 2 and
    $auth.environments[0].registrator.subject == "system:serviceaccount:custom:operator # literal"
  ' >/dev/null

# Check the rendered configuration with the same defaults and validation as startup.
STS_TEST_CONFIG_DIR="$config_dir" go test -count=1 ./internal/config -run '^TestLoadRenderedConfigs$'

# FQDN egress: one bare hostname per registrator JWKS host, deduplicated, and
# only when enabled and the GKE API is available.
fqdn_policy() {
  helm template authserver ../charts/sts-authserver --show-only templates/fqdnnetpol.yaml "$@" | yq -o=json
}
fqdn_policy --api-versions networking.gke.io/v1alpha3 \
  --set-json 'config.authorizationServer.environments=[
    {"name":"a","clientAuthIssuer":"https://a.example.com","registrator":{"subject":"s","registratorJwksUri":"https://op.example.com:8443/jwks","signingAlg":"ES256"}},
    {"name":"b","clientAuthIssuer":"https://b.example.com","registrator":{"subject":"s","registratorJwksUri":"https://op.example.com/jwks","signingAlg":"ES256"}},
    {"name":"c","clientAuthIssuer":"https://c.example.com","registrator":{"subject":"s","registratorJwksUri":"https://other.example.com/jwks","signingAlg":"ES256"}}
  ]' | jq -e '
    .kind == "FQDNNetworkPolicy" and
    .spec.egress == [{
      "to": [{"fqdns": ["op.example.com", "other.example.com"]}],
      "ports": [{"protocol": "TCP", "port": 443}]
    }]
  ' >/dev/null

for args in '' '--api-versions networking.gke.io/v1alpha3 --set fqdnNetworkPolicy.enabled=false'; do
  # shellcheck disable=SC2086 # Intentional word splitting of Helm flags.
  helm template authserver ../charts/sts-authserver $args | yq -o=json | jq -s -e '
    all(.[]; .kind != "FQDNNetworkPolicy")
  ' >/dev/null
done

printf 'authserver render tests passed\n'
