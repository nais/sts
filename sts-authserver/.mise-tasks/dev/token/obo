#!/usr/bin/env bash
#MISE description="Exchange a mock subject token at the k3d authserver with a Kubernetes service account"
#USAGE flag "-n --namespace <namespace>" help="Namespace of the client and target" default="sts-demo"
#USAGE flag "-w --workload <workload>" help="Service account of the client" default="consumer"
#USAGE flag "-t --target_workload <target_workload>" help="Target workload" default="smoke-client"
set -euo pipefail
source "$(dirname "$0")/_common"

REDIRECT_URI="https://unused.example/callback"
if ! AUTHORIZATION=$(curl -sS --fail-with-body --get --write-out '%{redirect_url}' \
  "http://localhost:3004/subject1/authorize" \
  -d 'client_id=default_client' -d 'scope=openid%20somescope' -d 'response_type=code' \
  -d 'response_mode=query' -d 'state=1234' -d 'nonce=5678' -d "redirect_uri=${REDIRECT_URI}"); then
  printf '%s\n' "${AUTHORIZATION}" >&2
  exit 1
fi
CODE=$(jq -rR 'capture("[?&]code=(?<code>[^&]+)").code' <<< "${AUTHORIZATION}")

if ! SUBJECT_RESPONSE=$(curl -sS --fail-with-body "http://localhost:3004/subject1/token" \
  -d 'grant_type=authorization_code' -d "code=${CODE}" -d 'client_secret=yolo' \
  -d 'client_id=default_client' -d "redirect_uri=${REDIRECT_URI}"); then
  printf '%s\n' "${SUBJECT_RESPONSE}" >&2
  exit 1
fi
SUBJECT_TOKEN=$(jq -r '.access_token' <<< "${SUBJECT_RESPONSE}")

WORKLOAD_TOKEN=$(workload_token "${usage_namespace}" "${usage_workload}")
printf '%s\n' "Authenticating with token:"
inspect <<< "${WORKLOAD_TOKEN}"

post_token \
  -d 'grant_type=urn:ietf:params:oauth:grant-type:token-exchange' \
  -d 'client_assertion_type=urn:ietf:params:oauth:client-assertion-type:jwt-bearer' \
  -d "client_assertion=${WORKLOAD_TOKEN}" \
  -d "audience=${CLUSTER}:${usage_namespace}:${usage_target_workload}" \
  -d "subject_token=${SUBJECT_TOKEN}" \
  -d 'subject_token_type=urn:ietf:params:oauth:token-type:jwt' \
  -d 'requested_token_type=urn:ietf:params:oauth:token-type:access_token'
