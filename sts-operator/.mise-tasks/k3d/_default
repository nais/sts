#!/usr/bin/env bash
#MISE description="Create a development Kubernetes cluster and write its dedicated kubeconfig"
set -euo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/../.."
umask 077
mkdir -p .local
api_port=${K3D_API_PORT:-6553}

if ! docker info > /dev/null 2>&1; then
  echo 'Docker is unavailable. Start Docker Desktop (or your Docker runtime) first.' >&2
  exit 1
fi
if ! k3d cluster list -o json | jq -e 'any(.[]; .name == "sts-operator-dev")' > /dev/null; then
  k3d cluster create sts-operator-dev --servers 1 --agents 0 \
    --image rancher/k3s:v1.35.2-k3s1 --api-port "127.0.0.1:$api_port" \
    --k3s-arg "--kube-apiserver-arg=service-account-issuer=https://127.0.0.1:$api_port@server:0" \
    --k3s-arg "--kube-apiserver-arg=service-account-jwks-uri=https://127.0.0.1:$api_port/openid/v1/jwks@server:0" \
    --k3s-arg '--kube-apiserver-arg=anonymous-auth=true@server:0' \
    --kubeconfig-update-default=false --kubeconfig-switch-context=false --wait --timeout=120s
else
  k3d cluster start sts-operator-dev --wait --timeout=120s
fi
k3d kubeconfig get sts-operator-dev > .local/kubeconfig.tmp
mv .local/kubeconfig.tmp .local/kubeconfig
kube() { kubectl --kubeconfig="$PWD/.local/kubeconfig" --context=k3d-sts-operator-dev "$@"; }
kube get --raw /.well-known/openid-configuration |
  jq -e --arg issuer "https://127.0.0.1:$api_port" \
    '.issuer == $issuer and .jwks_uri == ($issuer + "/openid/v1/jwks")' > /dev/null ||
  { echo 'Cluster issuer differs. Run k3d:down, then k3d again to recreate this development cluster.' >&2; exit 1; }
kube apply -f config/crd/bases/nais.io_oauthclients.yaml -f config/local/bootstrap.yaml
kube wait --for=condition=Established crd/oauthclients.nais.io --timeout=60s
kube config view --raw -o jsonpath='{.clusters[0].cluster.certificate-authority-data}' | base64 -d > .local/ca.crt
printf 'Kubeconfig: %s/.local/kubeconfig\nCA certificate: %s/.local/ca.crt\n' "$PWD" "$PWD"
