FROM --platform=$BUILDPLATFORM golang:1.27.1 AS builder
ENV CGO_ENABLED=0
WORKDIR /src
COPY config/local/mock-sts/main.go ./main.go
ARG TARGETOS
ARG TARGETARCH
RUN GOOS=$TARGETOS GOARCH=$TARGETARCH go build -o /mock-sts main.go

FROM scratch
COPY --from=builder /mock-sts /mock-sts
USER 65532:65532
ENTRYPOINT ["/mock-sts"]
