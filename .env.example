BIND_ADDRESS=:8080
INTERNAL_BIND_ADDRESS=:8081
DATABASE_URL=postgres://postgres:postgres@localhost:5432/sts?sslmode=disable
ISSUER=http://localhost:8080
LOG_LEVEL=info
LOG_FORMAT=text
CLIENT_AUTH_ISSUERS=http://localhost:3004/env1,http://localhost:3004/env2

# Inputs for the token tasks. The audience is the target client.
CLIENT_ID=tenant:cluster:namespace:workload
WORKLOAD_NAME=debug
TOKEN_AUDIENCE=tenant:cluster:namespace:other-workload
